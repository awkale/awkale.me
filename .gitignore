node_modules/
.react-router/
build/
dist/

# Contentful credentials. Never commit a token, regardless of repo visibility.
*cma-token*
.contentful-cma-token
.contentful-cda-token

# Derived/regenerable artifacts from scripts/contentful.
# bso-graph.json is parser OUTPUT, not Contentful state — regenerate with
#   python3 scripts/contentful/parse_archive.py   (needs openpyxl)
# It was deliberately untracked in the repo this migrated from; kept that way.
scripts/contentful/bso-graph.json
scripts/contentful/import-state.json
scripts/contentful/*.log
__pycache__/

.env
.env.*
!.env.example
.DS_Store
*.log
.cache/
.netlify/

# Browser-session artifacts from the Playwright MCP — page snapshots and console
# logs, written into the repo root whenever a browser drives the site. Regenerable,
# timestamped, and of no value once read. `*.log` above already caught the console
# files, which is why only the .yml snapshots ever showed up.
.playwright-mcp/
